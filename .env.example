# ==========================================
# PlateVision ANPR Platform Configuration
# ==========================================

# Application
PROJECT_NAME="PlateVision ANPR"
ENVIRONMENT=development
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# Security & JWT
SECRET_KEY="platevision-super-secret-production-grade-jwt-key-2026-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Default: SQLite for zero-setup instant local execution.
# Production: postgresql+psycopg2://postgres:postgres@localhost:5432/platevision
DATABASE_URL="sqlite:///./platevision.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Machine Learning & Computer Vision
YOLO_MODEL_PATH="./ml/models/plate_detector.pt"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Initial Admin Account
ADMIN_EMAIL="admin@platevision.ai"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AdminPassword@123"

# CORS
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'
